{
  "name": "desksync-desktop",
  "productName": "Desksync",
  "version": "0.4.0",
  "description": "Private two-way file synchronization for your desktop",
  "author": {
    "name": "Afrosoftware",
    "email": "support@afrosoftware.com"
  },
  "homepage": "https://afrosoftware.com/software/desksync",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../../tests/desktop.test.cjs"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.afrosoftware.desksync",
    "executableName": "desksync-desktop",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "policy.cjs",
      "startup.html",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../artifacts/desktop-dev/backend",
        "to": "backend"
      }
    ],
    "directories": {
      "output": "../../artifacts/desktop-release"
    },
    "artifactName": "Desksync-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Network",
      "icon": "icon.png",
      "maintainer": "Afrosoftware <support@afrosoftware.com>",
      "desktop": {
        "entry": {
          "StartupWMClass": "desksync-desktop"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libnotify4",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "xdg-utils"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "sign": false
    }
  }
}
